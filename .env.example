# Public address of the app, used for links in emails.
# Set this in production, e.g. https://sign.example.com
APP_URL=

# Port for the API (and the built frontend, when frontend/dist exists).
PORT=3001

# --- Company sign-in (optional; can also be set in Admin > Sign-in) ---
# Set to false to allow company accounts only.
# ALLOW_SIGNUP=true
# Active Directory over LDAP
# LDAP_URL=ldaps://dc01.corp.example.com:636
# LDAP_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_BIND_DN=svc-docysign@corp.example.com
# LDAP_BIND_PASSWORD=
# LDAP_ALLOWED_GROUP=CN=DocySign Users,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_ADMIN_GROUP=CN=DocySign Admins,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_START_TLS=false
# LDAP_ALLOW_SELF_SIGNED=false
# Microsoft Entra ID single sign-on (set APP_URL too)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_ALLOWED_GROUP=
# ENTRA_ADMIN_GROUP=

# --- Email, option 1: any SMTP server or relay service ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=DocySign
# Only for a mail server with a self-signed certificate. Servers on
# localhost are always allowed.
SMTP_ALLOW_SELF_SIGNED=false
# For an internal relay (IIS SMTP, Exchange, Postfix) that trusts this
# server's IP address: set the relay's address and port above, leave
# SMTP_USER and SMTP_PASS empty, and set this to true. SMTP_FROM is required.
SMTP_NO_AUTH=false

# --- Email, option 2: Microsoft 365 through the Graph API (no password) ---
# App registration with the Mail.Send application permission and admin consent.
# MAIL_PROVIDER=graph
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER=sign@yourcompany.com
