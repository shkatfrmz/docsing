# Public address of the app, used for links in emails.
# Set this in production, e.g. https://sign.example.com
APP_URL=

# Port for the API (and the built frontend, when frontend/dist exists).
PORT=3001

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=DocySign
# Only for a mail server with a self-signed certificate. Servers on
# localhost are always allowed.
SMTP_ALLOW_SELF_SIGNED=false
