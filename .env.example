# Public address of the app, used for links in emails.
# Set this in production, e.g. https://sign.example.com
APP_URL=

# Port for the API (and the built frontend, when frontend/dist exists).
PORT=3001

# --- Option 1: any SMTP server or relay service ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=DocySign
# Only for a mail server with a self-signed certificate. Servers on
# localhost are always allowed.
SMTP_ALLOW_SELF_SIGNED=false
# For an internal relay (IIS SMTP, Exchange, Postfix) that trusts this
# server's IP address: set the relay's address and port above, leave
# SMTP_USER and SMTP_PASS empty, and set this to true. SMTP_FROM is required.
SMTP_NO_AUTH=false

# --- Option 2: Microsoft 365 through the Graph API (no password) ---
# App registration with the Mail.Send application permission and admin consent.
# MAIL_PROVIDER=graph
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER=sign@yourcompany.com
